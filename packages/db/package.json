{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared database package for Prisma + Neon Postgres",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:migrate:create": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "dotenv": "^16.6.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "7.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}